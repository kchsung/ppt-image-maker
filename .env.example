VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_MOCK=false

# Supabase Edge Function secrets
OPENAI_API_KEY=
OPENAI_PPT_PLAN_MODEL=gpt-5

